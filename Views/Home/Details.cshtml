@model TasteSphere.Models.Recipe

@{
    ViewData["Title"] = Model.RecipeName;

    var ingredients =
        (IEnumerable<TasteSphere.Models.RecipeIngredient>)ViewBag.Ingredients;

    var steps =
        (IEnumerable<TasteSphere.Models.RecipeStep>)ViewBag.Steps;
}

<style>
    body {
        background: #faf8f4;
        color: #252525;
    }

    .details-container {
        max-width: 1100px;
        margin: 35px auto 60px;
        padding: 0 15px;
    }

    .back-link {
        display: inline-block;
        color: #555;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .back-link:hover {
        color: #e76f51;
    }

    .recipe-main {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid #eee;
        box-shadow: 0 8px 30px rgba(0,0,0,0.07);
        margin-bottom: 30px;
    }

    .recipe-main-image {
        width: 100%;
        height: 390px;
        object-fit: cover;
        display: block;
    }

    .recipe-image-placeholder {
        height: 390px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 100px;
        background: linear-gradient(135deg, #fff1e8, #f8ddd0);
    }

    .recipe-main-content {
        padding: 35px;
    }

    .country-label {
        display: inline-block;
        background: #fff0eb;
        color: #e76f51;
        padding: 7px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .recipe-title {
        font-size: 45px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .recipe-description {
        color: #707070;
        font-size: 17px;
        line-height: 1.7;
        margin-bottom: 25px;
    }

    .info-box {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .info-item {
        background: #f8f6f3;
        padding: 11px 15px;
        border-radius: 12px;
        color: #555;
        font-size: 14px;
    }

    .info-item strong {
        color: #252525;
    }

    .section-box {
        background: white;
        padding: 30px;
        border-radius: 24px;
        border: 1px solid #eee;
        box-shadow: 0 6px 22px rgba(0,0,0,0.05);
        margin-bottom: 25px;
    }

    .section-title {
        font-size: 27px;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .ingredient-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .ingredient-item {
        background: #faf8f4;
        border: 1px solid #eee;
        padding: 15px 18px;
        border-radius: 13px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .ingredient-name {
        font-weight: 600;
    }

    .ingredient-quantity {
        color: #e76f51;
        font-weight: 700;
        white-space: nowrap;
    }

    .step-item {
        display: flex;
        gap: 18px;
        padding: 18px 0;
        border-bottom: 1px solid #eee;
    }

    .step-item:last-child {
        border-bottom: none;
    }

    .step-number {
        min-width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #e76f51;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .step-content strong {
        font-size: 16px;
    }

    .step-content p {
        color: #666;
        line-height: 1.7;
        margin: 6px 0 0;
    }

    .bottom-back {
        display: inline-block;
        background: #252525;
        color: white;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 25px;
        font-weight: 700;
    }

    .bottom-back:hover {
        background: #e76f51;
        color: white;
    }

    .empty-message {
        color: #777;
        padding: 10px 0;
    }

    @@media (max-width: 768px) {

        .recipe-title {
            font-size: 34px;
        }

        .recipe-main-image,
        .recipe-image-placeholder {
            height: 280px;
        }

        .recipe-main-content,
        .section-box {
            padding: 22px;
        }

        .ingredient-list {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="details-container">

    <a href="@Url.Action("Index", "Home")"
       class="back-link">
        ← Back to Recipes
    </a>

    <div class="recipe-main">

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.RecipeName"
                 class="recipe-main-image" />
        }
        else
        {
            <div class="recipe-image-placeholder">
                🍽️
            </div>
        }

        <div class="recipe-main-content">

            <span class="country-label">
                🌍 @Model.Cuisine?.CountryName
            </span>

            <h1 class="recipe-title">
                @Model.RecipeName
            </h1>

            <p class="recipe-description">
                @Model.Description
            </p>

            <div class="info-box">

                <div class="info-item">
                    🍴 <strong>Cuisine:</strong>
                    @Model.Cuisine?.CuisineName
                </div>

                <div class="info-item">
                    ⏱️ <strong>Prep:</strong>
                    @Model.PrepTime mins
                </div>

                <div class="info-item">
                    🔥 <strong>Cook:</strong>
                    @Model.CookTime mins
                </div>

                <div class="info-item">
                    👥 <strong>Servings:</strong>
                    @Model.Servings
                </div>

                <div class="info-item">
                    📊 <strong>Difficulty:</strong>
                    @Model.Difficulty
                </div>

                <div class="info-item">
                    🍽️ <strong>Category:</strong>
                    @Model.Category?.CategoryName
                </div>

            </div>

        </div>
    </div>

    <div class="section-box">

        <h2 class="section-title">
            🥕 Ingredients
        </h2>

        @if (ingredients.Any())
        {
            <div class="ingredient-list">

                @foreach (var item in ingredients)
                {
                    <div class="ingredient-item">

                        <span class="ingredient-name">
                            🥕 @item.Ingredient?.IngredientName
                        </span>

                        <span class="ingredient-quantity">
                            @item.Quantity
                        </span>

                    </div>
                }

            </div>
        }
        else
        {
            <p class="empty-message">
                No ingredients available.
            </p>
        }

    </div>

    <div class="section-box">

        <h2 class="section-title">
            👩‍🍳 How to Make It
        </h2>

        @if (steps.Any())
        {
            @foreach (var step in steps)
            {
                <div class="step-item">

                    <div class="step-number">
                        @step.StepNumber
                    </div>

                    <div class="step-content">

                        <strong>
                            Step @step.StepNumber
                        </strong>

                        <p>
                            @step.Instruction
                        </p>

                    </div>

                </div>
            }
        }
        else
        {
            <p class="empty-message">
                Cooking steps are not available.
            </p>
        }

    </div>

    <a href="@Url.Action("Index", "Home")"
       class="bottom-back">
        ← Back to All Recipes
    </a>

</div>